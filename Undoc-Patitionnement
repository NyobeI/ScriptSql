Table de pilotage
L'utilisation d'une table de pilotage permet d'avoir du code générique et flexible.
Nom des colonnes	Description
nom_table	nom d'une table partitionnée
cod_grain	description du grain de la partition, valeurs possibles: annuel, trimestriel, mensuel, quotidien
nbr_partition_minimum	nombre minimum de partitions à conserver
nbr_partition_avance	nombre de partitions en avance
ind_conservation	indique si on désire conserver la dernière partition supprimée (développement futur)
num_ordre	ordre dans lequel les tables sont traitées

Script de la table de pilotage
create table parametrage_partition (
nom_table varchar(200) not null,
cod_grain varchar(11) not null constraint parametrage_partition_chk1 check(cod_grain in ('annuel','trimestriel','mensuel','quotidien')),
nbr_partition_minimum smallint not null ,
nbr_partition_avance smallint not null constraint parametrage_partition_chk2 check (nbr_partition_avance between 1 and 30),
num_ordre smallint not null constraint parametrage_partition_chk3 check (num_ordre between 1 and 100),
tms_creation datetimeoffset not null constraint parametrage_partition_defaut1 default sysdatetimeoffset(),
constraint parametrage_partition_pk primary key (nom_table));
GO


