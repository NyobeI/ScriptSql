Ajout de partitions
Déterminer la borne de la dernière partition
et ajouter une partition selon le grain de la table.
Le select doit être ajusté selon qu'il est utilisé dans une boucle ou pas pour traiter toutes les tables partitionnées.
	with borne_superieure as
(SELECT  max (rv.value) AS borne, t.name as nom_table
FROM sys.tables AS t  
JOIN sys.indexes AS i  ON t.object_id = i.object_id  
JOIN sys.partitions AS p   ON i.object_id = p.object_id AND i.index_id = p.index_id   
JOIN  sys.partition_schemes AS s  ON i.data_space_id = s.data_space_id  
JOIN sys.partition_functions AS f  ON s.function_id = f.function_id  
LEFT JOIN sys.partition_range_values AS r   ON f.function_id = r.function_id and r.boundary_id = p.partition_number  
LEFT JOIN sys.partition_range_values AS rv  ON f.function_id = rv.function_id AND p.partition_number = rv.boundary_id     
LEFT JOIN sys.partition_range_values AS rv2  ON f.function_id = rv2.function_id AND p.partition_number - 1= rv2.boundary_id
WHERE   i.type <= 1 
group by t.name)
select case pp.cod_grain when 'annuel' then dateadd (yyyy, 1, convert(date,borne))  
                         when 'trimestriel' then dateadd (qq, 1, convert(date,borne))  
                         when 'mensuel' then dateadd (mm, 1, convert(date,borne))  
                         when 'quotidien' then dateadd (q, 1, convert(date,borne))  end as nouvelle_borne,  pp.nom_table
from borne_superieure bs join parametrage_partition pp on bs.nom_table =pp.nom_table
order by pp.num_ordre	nouvelle_borne    nom_table
